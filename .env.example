# 공공데이터포털 서비스키
#
# 주의: 포털 마이페이지에는 "인코딩"/"디코딩" 두 가지 키가 있다.
#       반드시 >>> 디코딩(Decoding) <<< 키를 넣을 것.
#       인코딩 키를 넣으면 httpx가 한 번 더 인코딩해서 (%2B -> %252B)
#       SERVICE_KEY_IS_NOT_REGISTERED_ERROR 가 뜬다.
#
# 활용신청 승인 후 반영까지 최대 1시간 걸릴 수 있다.
SERVICE_KEY=여기에_디코딩_키

# 선택: HTTP 타임아웃(초), 기본 10
# TRUEETA_TIMEOUT=10
