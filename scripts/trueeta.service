[Unit]
Description=TrueETA bus arrival board
# 라즈베리파이는 RTC 가 없다. 시계가 맞기 전에 뜨면 폴러가 운행시간을
# 잘못 판단한다 (docs/incident-2026-09-24.md). 앱에서도 한 번 더 기다리지만
# (src/trueeta/clock.py) 여기서 막아주면 그 대기가 아예 필요 없어진다.
#
#   time-sync.target 이 실제로 '동기화 완료' 를 뜻하려면
#   systemd-time-wait-sync 가 켜져 있어야 한다:
#     sudo systemctl enable --now systemd-time-wait-sync
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=hun
WorkingDirectory=/home/hun/TrueETA
ExecStart=/home/hun/TrueETA/.venv/bin/python -m trueeta
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
